# RevOps Buddy Environment Configuration

# Required: Groq API Key
# Get yours at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Optional: LiteLLM configuration (if using different provider)
# LITELLM_PROVIDER=groq
# LITELLM_API_KEY=your-key-here

# Optional: Model configuration
# MODEL_ID=groq/llama-3.3-70b-versatile
# MODEL_TEMPERATURE=0.2

# Optional: Voice configuration
# WHISPER_MODEL=medium.en
# WHISPER_LANGUAGE=en
# VOICE_NAME=Samantha
# VOICE_RATE=200

# Optional: Data source (for production)
# DATA_SOURCE=csv  # or 'postgres', 'mysql', 'api'
# DATA_PATH=/path/to/pipeline_data.csv
# DATABASE_URL=postgresql://user:pass@localhost/dbname
