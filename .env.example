# RevOps Buddy v2: copy to .env and fill in. Never commit .env.

# Public HTTPS origin MeetingBaas can reach (e.g. a tunnel). Used to build the wss:// audio URLs.
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Optional bearer token required on POST /meetings and /leave
API_TOKEN=

# Data: "synthetic" uses the bundled demo company; "live" syncs HubSpot before each call
DATA_MODE=synthetic
DATABASE_URL=sqlite:///revops_buddy.db
# Live mode only
HUBSPOT_ACCESS_TOKEN=
COMPANY_CONFIG_PATH=
PRESYNC_MAX_AGE_SECONDS=300

# Call
BOT_NAME=Angels
MEETING_LANGUAGE=en

# Providers
MEETINGBAAS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TTS_VOICE_ID=
TTS_VOICE_ID_ES=
TTS_MODEL=eleven_flash_v2_5
